# ─── Django ───────────────────────────────────────────────
SECRET_KEY=your-very-secret-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ─── Database ─────────────────────────────────────────────
DB_NAME=bale_bot_db
DB_USER=bale_bot_user
DB_PASSWORD=strong_password_here
DB_HOST=db
DB_PORT=5432

# ─── Bale Bot ─────────────────────────────────────────────
BALE_BOT_TOKEN=your_bale_bot_token_from_botfather
BALE_API_BASE_URL=https://tapi.bale.ai/bot
BALE_FILE_BASE_URL=https://tapi.bale.ai/file/bot

# ─── Admin ────────────────────────────────────────────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin_strong_password
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ─── Media / Static ───────────────────────────────────────
MEDIA_URL=/media/
STATIC_URL=/static/

# ─── Admin Notifications ──────────────────────────────────────
# Optional: your Bale user_id or group_id to receive new-registration pings
BALE_ADMIN_CHAT_ID=
